{
    "entities": {
        "user": {
            "title": "User",
            "description": "A user of the application.",
            "type": "object",
            "properties": {
                "uid": {
                    "type": "string",
                    "description": "The user's unique ID."
                },
                "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The user's email address."
                },
                "displayName": {
                    "type": "string",
                    "description": "The user's display name."
                },
                "photoURL": {
                    "type": "string",
                    "format": "uri",
                    "description": "The URL of the user's profile picture."
                }
            },
            "required": [
                "uid"
            ]
        },
        "cartItem": {
            "title": "Cart Item",
            "description": "An item within a shopping cart or booking.",
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "price": { "type": "number" },
                "imageUrl": { "type": "string", "format": "uri" },
                "selectedDate": { "type": "string", "format": "date-time" },
                "selectedTime": { "type": "string" },
                "quantity": { "type": "number" }
            },
            "required": ["id", "name", "price", "quantity", "selectedDate", "selectedTime"]
        },
        "booking": {
            "title": "Booking",
            "description": "A booking made by a user, containing one or more services.",
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "userId": { "type": "string" },
                "items": {
                    "type": "array",
                    "items": { "$ref": "#/backend/entities/cartItem" }
                },
                "total": { "type": "number" },
                "deliveryFee": { "type": "number" },
                "platformFee": { "type": "number" },
                "finalTotal": { "type": "number" },
                "placedAt": { "type": "string", "format": "date-time" },
                "deliveryAddress": {
                    "type": "object",
                    "properties": {
                        "type": { "type": "string" },
                        "address": { "type": "string" }
                    }
                }
            },
            "required": ["id", "userId", "items", "finalTotal", "placedAt"]
        }
    },
    "auth": {
        "providers": [
            "phone"
        ]
    },
    "firestore": {
        "/users/{userId}": {
            "schema": {
                "$ref": "#/backend/entities/user"
            },
            "description": "Stores user profile information."
        },
        "/users/{userId}/bookings/{bookingId}": {
            "schema": {
                "$ref": "#/backend/entities/booking"
            },
            "description": "Stores user's booking history."
        }
    }
}
