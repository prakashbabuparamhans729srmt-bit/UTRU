
{
    "metadata": {
        "ui_documentation_status": "Page 1-7 descriptions provided in chat for Bubble.io conversion.",
        "last_documented_page": "Payment Settings"
    },
    "entities": {
        "user": {
            "title": "User",
            "description": "A user of the application.",
            "type": "object",
            "properties": {
                "uid": {
                    "type": "string",
                    "description": "The user's unique ID."
                },
                "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The user's email address."
                },
                "displayName": {
                    "type": "string",
                    "description": "The user's display name."
                },
                "photoURL": {
                    "type": "string",
                    "format": "uri",
                    "description": "The URL of the user's profile picture."
                },
                "phoneNumber": {
                    "type": "string",
                    "description": "The user's phone number."
                },
                "walletBalance": {
                    "type": "number",
                    "description": "The user's current wallet balance. New users receive a ₹100 sign-up bonus."
                },
                "country": {
                    "type": "string",
                    "description": "The user's country."
                },
                "state": {
                    "type": "string",
                    "description": "The user's state."
                }
            },
            "required": [
                "uid"
            ]
        },
        "address": {
            "title": "Address",
            "description": "A user's delivery address.",
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "type": { "type": "string", "enum": ["Home", "Work", "Hotel", "Other"] },
                "name": { "type": "string" },
                "mobile": { "type": "string" },
                "fullAddress": { "type": "string", "description": "Flat, House no, Building, Apartment" },
                "floor": { "type": "string" },
                "landmark": { "type": "string" }
            },
            "required": ["type", "name", "mobile", "fullAddress"]
        },
        "cartItem": {
            "title": "Cart Item",
            "description": "An item within a shopping cart or booking.",
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "price": { "type": "number" },
                "imageUrl": { "type": "string", "format": "uri" },
                "selectedDate": { "type": "string", "format": "date-time" },
                "selectedTime": { "type": "string" },
                "quantity": { "type": "number" }
            },
            "required": ["id", "name", "price", "quantity", "selectedDate", "selectedTime"]
        },
        "booking": {
            "title": "Booking",
            "description": "A booking made by a user, containing one or more services.",
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "userId": { "type": "string" },
                "items": {
                    "type": "array",
                    "items": { "$ref": "#/backend/entities/cartItem" }
                },
                "total": { "type": "number" },
                "deliveryFee": { "type": "number" },
                "platformFee": { "type": "number" },
                "discount": {
                    "type": "number",
                    "description": "Discount applied to the booking."
                },
                "couponCode": {
                    "type": "string",
                    "description": "The coupon code used for the discount."
                },
                "finalTotal": { "type": "number" },
                "placedAt": { "type": "string", "format": "date-time" },
                "deliveryAddress": {
                    "$ref": "#/backend/entities/address"
                },
                "paymentMethod": {
                    "type": "string",
                    "enum": ["wallet", "cod"],
                    "description": "The payment method used for the booking."
                },
                "status": {
                    "type": "string",
                    "enum": ["Placed", "Confirmed", "In Progress", "Completed", "Cancelled"],
                    "description": "The current status of the booking."
                },
                "rating": {
                    "type": "number",
                    "description": "User's rating for this booking, from 1 to 5."
                },
                "review": {
                    "type": "string",
                    "description": "User's text review for this booking."
                }
            },
            "required": ["id", "userId", "items", "finalTotal", "placedAt", "deliveryAddress"]
        },
        "walletTransaction": {
            "title": "Wallet Transaction",
            "description": "A single transaction in the user's wallet history.",
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "amount": {
                    "type": "number",
                    "description": "The transaction amount. Positive for credit, negative for debit."
                },
                "type": {
                    "type": "string",
                    "enum": ["credit", "debit"]
                },
                "description": {
                    "type": "string",
                    "description": "A brief description of the transaction (e.g., 'Referral Bonus', 'Refund for Order #XYZ')."
                },
                "timestamp": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The date and time of the transaction."
                }
            },
            "required": [
                "amount",
                "type",
                "description",
                "timestamp"
            ]
        },
        "shortVideo": {
            "title": "Short Video",
            "description": "A short video created by the company.",
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "views": {
                    "type": "string"
                },
                "imageId": {
                    "type": "string"
                },
                "userId": {
                    "type": "string",
                    "description": "The UID of the user who created the short."
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "required": [
                "id",
                "title",
                "userId",
                "createdAt"
            ]
        },
        "content": {
            "title": "Dynamic Content",
            "description": "Stores dynamic content managed from the admin panel.",
            "type": "object",
            "properties": {
                "title": { "type": "string" },
                "type": { 
                    "type": "string",
                    "enum": [
                        "मौसम", 
                        "आपातकालीन", 
                        "स्थानीय समाचार", 
                        "स्थानीय आँकड़े", 
                        "जिला प्रशासन", 
                        "जिला वेब सूची", 
                        "राज्य वेब सूची", 
                        "देश वेब सूची", 
                        "banner"
                    ],
                    "description": "Categorization of content for specific frontend tabs."
                },
                "location": { "type": "string" },
                "priority": { "type": "string" },
                "publishDate": { "type": "string" },
                "publishTime": { "type": "string" },
                "expiryDate": { "type": "string" },
                "expiryTime": { "type": "string" },
                "contentData": { "type": "string", "description": "JSON formatted string or plain text depending on type." },
                "sendNotification": { "type": "boolean" },
                "notificationMessage": { "type": "string" },
                "createdBy": { "type": "string" },
                "createdAt": { "type": "object" }
            },
            "required": ["title", "type", "contentData", "createdBy", "createdAt"]
        }
    },
    "auth": {
        "providers": [
            "phone",
            "google.com",
            "password"
        ]
    },
    "firestore": {
        "/users/{userId}": {
            "schema": {
                "$ref": "#/backend/entities/user"
            },
            "description": "Stores user profile information."
        },
        "/users/{userId}/addresses/{addressId}": {
            "schema": {
                "$ref": "#/backend/entities/address"
            },
            "description": "Stores user's saved addresses."
        },
        "/users/{userId}/bookings/{bookingId}": {
            "schema": {
                "$ref": "#/backend/entities/booking"
            },
            "description": "Stores user's booking history."
        },
        "/users/{userId}/walletTransactions/{transactionId}": {
            "schema": {
                "$ref": "#/backend/entities/walletTransaction"
            },
            "description": "Stores a user's wallet transaction history. A 'Sign-up Bonus' transaction is added for new users."
        },
        "/shorts/{shortId}": {
            "schema": {
                "$ref": "#/backend/entities/shortVideo"
            },
            "description": "Stores short videos created by the company to be shown to customers."
        },
        "/content/{contentId}": {
            "schema": {
                "$ref": "#/backend/entities/content"
            },
            "description": "Stores dynamic content for various sections of the app, managed via the admin panel."
        }
    }
}
