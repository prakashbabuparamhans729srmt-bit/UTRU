
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId} {
      // Allow users to read their own document.
      allow read: if isOwner(userId);

      // Allow users to create their own document only with specific initial data.
      allow create: if request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.walletBalance == 100
                    && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'phoneNumber', 'walletBalance'])
                    && request.resource.data.size() == 6;
      
      // Allow users to update their own document for profile changes (balance unchanged)
      // or for wallet payments (balance decreases). This rule allows updates if the
      // walletBalance is not being modified, or if it is being decreased.
      allow update: if isOwner(userId) && 
                    (
                      ('walletBalance' in request.resource.data && request.resource.data.walletBalance <= resource.data.walletBalance) 
                      || !('walletBalance' in request.resource.data)
                    );
    }
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/bookings/{bookingId} {
      allow read: if isOwner(userId);

      // Allow creation only with valid, user-submitted data
      allow create: if isOwner(userId)
              && request.resource.data.userId == userId
              && request.resource.data.id == bookingId
              && request.resource.data.status == 'Placed'
              && request.resource.data.placedAt == request.time
              && request.resource.data.paymentMethod in ['wallet', 'cod']
              && !('rating' in request.resource.data)
              && !('review' in request.resource.data)
              && request.resource.data.items.size() > 0;
              
      // Only allow updating rating and review after completion.
      allow update: if isOwner(userId)
                    && resource.data.status == 'Completed'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'review']);

      allow delete: if false;
    }
    match /users/{userId}/walletTransactions/{transactionId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) && (
        // Allow sign-up bonus credit transaction
        (
          request.resource.data.type == 'credit' &&
          request.resource.data.amount == 100 &&
          request.resource.data.description == 'Sign-up Bonus' &&
          request.resource.data.timestamp == request.time &&
          request.resource.data.keys().hasAll(['amount', 'type', 'description', 'timestamp']) &&
          request.resource.data.size() == 4
        ) ||
        // Allow booking payment debit transaction
        (
          request.resource.data.type == 'debit' &&
          request.resource.data.amount < 0 &&
          request.resource.data.description.matches('Payment for Booking #[A-Z0-9]{8}') &&
          request.resource.data.timestamp == request.time &&
          request.resource.data.keys().hasAll(['amount', 'type', 'description', 'timestamp']) &&
          request.resource.data.size() == 4
        )
      );

      allow update, delete: if false;
    }
  }
}
