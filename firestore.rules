
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Allow initial creation with sign-up bonus
      allow create: if request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.walletBalance == 100;
      
      // Allow updates to wallet balance and profile
      allow update: if isOwner(userId) && 
                    (
                      ('walletBalance' in request.resource.data && request.resource.data.walletBalance >= 0) 
                      || !('walletBalance' in request.resource.data)
                    );
    }
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/bookings/{bookingId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
              && request.resource.data.userId == userId
              && request.resource.data.status == 'Placed'
              && request.resource.data.placedAt == request.time;
              
      allow update: if isOwner(userId)
                    && (
                      (resource.data.status == 'Completed' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'review']))
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    );

      allow delete: if false;
    }
    match /users/{userId}/walletTransactions/{transactionId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) && (
        // Credit (Sign-up, Recharge, or Refund)
        (
          request.resource.data.type == 'credit' &&
          request.resource.data.amount > 0 &&
          request.resource.data.timestamp == request.time
        ) ||
        // Debit (Payment for booking)
        (
          request.resource.data.type == 'debit' &&
          request.resource.data.amount < 0 &&
          request.resource.data.timestamp == request.time
        )
      );

      allow update, delete: if false;
    }
    match /shorts/{shortId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /content/{contentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
