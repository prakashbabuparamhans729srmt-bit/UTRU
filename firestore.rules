rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.walletBalance == 100
                    && request.resource.data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'phoneNumber', 'walletBalance'])
                    && request.resource.data.size() == 6;
    }
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/bookings/{bookingId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/walletTransactions/{transactionId} {
      allow read: if isOwner(userId);
      // Allow a user to create their own first transaction only if it's the sign-up bonus.
      allow create: if isOwner(userId)
                    && request.resource.data.type == 'credit'
                    && request.resource.data.amount == 100
                    && request.resource.data.description == 'Sign-up Bonus'
                    && get(/databases/$(database)/documents/users/$(userId)/walletTransactions).size == 0;
      allow update, delete: if false;
    }
  }
}
